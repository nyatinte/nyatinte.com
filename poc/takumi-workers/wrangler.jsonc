{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nyatinte-takumi-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "rules": [{ "type": "Data", "globs": ["**/*.woff2"], "fallthrough": true }],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
