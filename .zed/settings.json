{
  "languages": {
    "TypeScript": {
      "formatter": [
        {
          "code_action": "source.fixAll.oxc"
        }
      ],
      "format_on_save": "on"
    },
    "TSX": {
      "formatter": [
        {
          "code_action": "source.fixAll.oxc"
        }
      ],
      "format_on_save": "on"
    },
    "JavaScript": {
      "formatter": [
        {
          "code_action": "source.fixAll.oxc"
        }
      ],
      "format_on_save": "on"
    },
    "Astro": {
      "formatter": [
        {
          "code_action": "source.fixAll.oxc"
        }
      ],
      "format_on_save": "on"
    }
  },
  "lsp": {
    "oxlint": {
      "binary": {
        "path": "pnpm",
        "arguments": ["exec", "oxlint", "--lsp"]
      },
      "initialization_options": {
        "settings": {
          "configPath": null,
          "fixKind": "safe_fix",
          "run": "onSave",
          "tsConfigPath": "./tsconfig.json",
          "typeAware": true
        }
      }
    }
  }
}
