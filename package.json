{
  "name": "nyatinte-com",
  "version": "0.0.0",
  "private": true,
  "author": {
    "name": "nyatinte",
    "url": "https://nyatinte.com"
  },
  "type": "module",
  "scripts": {
    "build": "wrangler types && svelte-kit sync && vp build",
    "check": "wrangler types && svelte-kit sync && ultracite check && pnpm run lint:svelte && vp check --no-fmt --no-lint && svelte-check --tsconfig ./tsconfig.json",
    "deploy": "APP_ENV=production pnpm build && tag=$(node -p 'crypto.randomUUID()') && APP_ENV=production varlock-wrangler versions upload --keep-vars=true --tag \"$tag\" && wrangler versions deploy --version-tag \"$tag\" --yes",
    "dev": "vp dev",
    "dev:worker": "varlock-wrangler dev .svelte-kit/cloudflare/_worker.js --local --port 8787",
    "fix": "ultracite fix",
    "lint:svelte": "eslint \"src/**/*.{svelte,svelte.js,svelte.ts}\"",
    "prepare": "svelte-kit sync && vp config --no-agent --hooks",
    "preview": "varlock-wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "test": "vp test --run",
    "types": "wrangler types"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@tabler/icons": "^3.51.0",
    "jose": "6.2.17",
    "marked": "18.2.0",
    "sanitize-html": "2.18.2",
    "valibot": "1.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@modelcontextprotocol/client": "2.4.0",
    "@sveltejs/adapter-cloudflare": "8.0.2",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.2",
    "@typescript-eslint/parser": "8.72.2",
    "@varlock/cloudflare-integration": "1.6.3",
    "@varlock/vite-integration": "1.5.2",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.23.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "ultracite": "7.12.0",
    "varlock": "1.24.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.158.0"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.22.2"
  }
}
