{
  "name": "nyatinte-com",
  "version": "0.0.0",
  "private": true,
  "description": "Personal site for nyatinte.com with a public log and a protected MCP API.",
  "homepage": "https://nyatinte.com",
  "bugs": {
    "url": "https://github.com/nyatinte/nyatinte.com/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nyatinte/nyatinte.com"
  },
  "license": "MIT",
  "author": {
    "name": "nyatinte",
    "url": "https://nyatinte.com"
  },
  "type": "module",
  "scripts": {
    "build": "wrangler types --include-main-module=false && svelte-kit sync && vp build && pnpm search:index",
    "check": "node --test scripts/test-parse-wrangler-version-id.mjs scripts/test-parse-preview-url.mjs && wrangler types --include-main-module=false && svelte-kit sync && pnpm run fmt:svelte:check && pnpm run lint && vp check && svelte-check --tsconfig ./tsconfig.json",
    "check:ci": "APP_ENV=test CF_SEND_TELEMETRY=false sh -c 'pnpm check && pnpm build && pnpm test:http'",
    "deploy": "sh scripts/deploy-worker.sh",
    "dev": "vp dev",
    "dev:worker": "varlock-wrangler dev .svelte-kit/cloudflare/_worker.js --local --port ${PORT:-8787}",
    "fix": "vp lint --fix",
    "fmt": "vp fmt && pnpm run fmt:svelte",
    "fmt:check": "vp fmt --check && pnpm run fmt:svelte:check",
    "fmt:svelte": "git ls-files -z -- '*.svelte' | xargs -0 rsvelte-fmt --print-width 80 --tab-width 2",
    "fmt:svelte:check": "git ls-files -z -- '*.svelte' | xargs -0 rsvelte-fmt --check --print-width 80 --tab-width 2",
    "lint": "vp lint --deny-warnings && pnpm run lint:css",
    "lint:css": "stylelint \"src/**/*.{css,svelte}\"",
    "prepare": "svelte-kit sync && vp config --no-agent --hooks",
    "preview": "varlock-wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "search:index": "tsx scripts/build-zbsearch.ts",
    "test": "vp test --run",
    "test:http": "APP_ENV=test CF_SEND_TELEMETRY=false sh scripts/test-built-worker.sh",
    "vitals": "svelte-vitals --no-animation"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@tabler/icons": "^3.51.0",
    "@zbsearch/tokenizers": "4.0.4",
    "jose": "6.2.18",
    "valibot": "1.5.0",
    "yaml": "2.9.1",
    "zbsearch": "4.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@nkzw/oxlint-config": "3.0.2",
    "@rsvelte/fmt": "0.7.27",
    "@rsvelte/oxlint-plugin": "0.2.6",
    "@sveltejs/adapter-cloudflare": "8.0.3",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "@varlock/cloudflare-integration": "1.6.4",
    "@varlock/vite-integration": "1.5.6",
    "mdsvex": "0.12.8",
    "postcss-html": "2.0.1",
    "remark-directive": "4.0.0",
    "remark-parse": "11.0.0",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "svelte-vitals": "0.57.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "varlock": "1.25.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.168.0"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.21.0"
  }
}
