{
  "name": "nyatinte-com",
  "version": "0.0.0",
  "private": true,
  "author": {
    "name": "nyatinte",
    "url": "https://nyatinte.com"
  },
  "type": "module",
  "scripts": {
    "build": "cf workers types && svelte-kit sync && vp build",
    "check": "cf workers types && svelte-kit sync && ultracite check && pnpm run lint:svelte && vp check --no-fmt --no-lint && svelte-check --tsconfig ./tsconfig.json && pnpm run poc:takumi:typecheck",
    "deploy": "APP_ENV=production pnpm build && tag=$(node -p 'crypto.randomUUID()') && APP_ENV=production varlock-wrangler versions upload --config wrangler.varlock.jsonc --keep-vars=true --tag \"$tag\" && wrangler versions deploy --config wrangler.varlock.jsonc --version-tag \"$tag\" --yes",
    "dev": "vp dev",
    "dev:worker": "varlock-wrangler dev --config wrangler.varlock.jsonc .svelte-kit/cloudflare/_worker.js --local --port 8787",
    "fix": "ultracite fix",
    "lint:svelte": "eslint \"src/**/*.{svelte,svelte.js,svelte.ts}\"",
    "poc:takumi:build": "wrangler deploy --config poc/takumi-workers/wrangler.jsonc --dry-run --outdir .wrangler/takumi-workers-poc",
    "poc:takumi:dev": "wrangler dev --config poc/takumi-workers/wrangler.jsonc --local --ip 127.0.0.1 --port 8788",
    "poc:takumi:test": "vp test --run poc/takumi-workers/integration.test.ts",
    "poc:takumi:typecheck": "tsrs -p poc/takumi-workers/tsconfig.json --noEmit",
    "prepare": "svelte-kit sync && vp config --no-agent --hooks",
    "preview": "varlock-wrangler dev --config wrangler.varlock.jsonc .svelte-kit/cloudflare/_worker.js --port 4173",
    "test": "vp test --run",
    "types": "cf workers types"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@tabler/icons": "^3.51.0",
    "jose": "6.2.17",
    "marked": "18.0.14",
    "sanitize-html": "2.18.1",
    "valibot": "1.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@modelcontextprotocol/client": "2.4.0",
    "@sveltejs/adapter-cloudflare": "8.0.2",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.13.6",
    "@types/sanitize-html": "2.16.2",
    "@typescript-eslint/parser": "8.70.0",
    "@varlock/cloudflare-integration": "1.6.3",
    "@varlock/vite-integration": "1.5.2",
    "budoux": "0.9.2",
    "cf": "1.0.0-beta.28",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "takumi-js": "2.14.0",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "typescript": "6.0.3",
    "ultracite": "7.12.0",
    "varlock": "1.24.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.158.0"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.22.2"
  }
}
