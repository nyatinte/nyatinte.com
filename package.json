{
  "name": "nyatinte-com",
  "version": "0.0.0",
  "private": true,
  "author": {
    "name": "nyatinte",
    "url": "https://nyatinte.com"
  },
  "type": "module",
  "scripts": {
    "build": "wrangler types && svelte-kit sync && vp build",
    "check": "wrangler types && svelte-kit sync && ultracite check && pnpm run lint:svelte && vp check --no-fmt --no-lint && svelte-check --tsconfig ./tsconfig.json && pnpm run poc:takumi:typecheck && pnpm run check:d1",
    "check:d1": "tsc --project tests/d1/tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "deploy": "pnpm build && varlock-wrangler deploy",
    "dev": "vp dev",
    "dev:worker": "varlock-wrangler dev .svelte-kit/cloudflare/_worker.js --local --port 8787",
    "fix": "ultracite fix",
    "lint:svelte": "eslint \"src/**/*.{svelte,svelte.js,svelte.ts}\"",
    "poc:takumi:build": "wrangler deploy --config poc/takumi-workers/wrangler.jsonc --dry-run --outdir .wrangler/takumi-workers-poc",
    "poc:takumi:dev": "wrangler dev --config poc/takumi-workers/wrangler.jsonc --local --ip 127.0.0.1 --port 8788",
    "poc:takumi:test": "vp test --run poc/takumi-workers/integration.test.ts",
    "poc:takumi:typecheck": "tsc -p poc/takumi-workers/tsconfig.json --noEmit",
    "prepare": "svelte-kit sync && vp config --no-agent --hooks",
    "preview": "varlock-wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "test": "vp test --run",
    "test:d1": "vp test --config vite.d1.config.ts --run",
    "types": "wrangler types"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "marked": "18.0.14",
    "sanitize-html": "2.17.7",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vitest-plugin": "1.2.8",
    "@sveltejs/adapter-cloudflare": "8.0.0-next.7",
    "@sveltejs/kit": "3.0.0-next.27",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.6",
    "@types/sanitize-html": "2.16.1",
    "@typescript-eslint/parser": "8.70.0",
    "@varlock/cloudflare-integration": "1.6.0",
    "@varlock/vite-integration": "1.5.2",
    "budoux": "0.9.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "takumi-js": "2.14.0",
    "typescript": "6.0.3",
    "ultracite": "7.12.0",
    "varlock": "1.20.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.135.0"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.21.0"
  }
}
