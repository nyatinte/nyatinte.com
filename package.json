{
  "name": "nyatinte-com",
  "version": "0.0.0",
  "private": true,
  "description": "Personal site for nyatinte.com with a public log and a protected MCP API.",
  "homepage": "https://nyatinte.com",
  "bugs": {
    "url": "https://github.com/nyatinte/nyatinte.com/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nyatinte/nyatinte.com"
  },
  "author": {
    "name": "nyatinte",
    "url": "https://nyatinte.com"
  },
  "type": "module",
  "scripts": {
    "build": "wrangler types --include-main-module=false && svelte-kit sync && vp build",
    "check": "wrangler types --include-main-module=false && svelte-kit sync && ultracite check && pnpm run lint:svelte && vp check --no-fmt --no-lint && svelte-check --tsconfig ./tsconfig.json",
    "check:ci": "APP_ENV=test CF_SEND_TELEMETRY=false sh -c 'pnpm check && pnpm build && pnpm test:http'",
    "deploy": "APP_ENV=production pnpm build && tag=$(node -p 'crypto.randomUUID()') && APP_ENV=production varlock-wrangler versions upload --keep-vars=true --tag \"$tag\" && wrangler versions deploy --version-tag \"$tag\" --yes",
    "dev": "vp dev",
    "dev:worker": "varlock-wrangler dev .svelte-kit/cloudflare/_worker.js --local --port ${PORT:-8787}",
    "fix": "ultracite fix",
    "lint:svelte": "eslint \"src/**/*.{svelte,svelte.js,svelte.ts}\"",
    "prepare": "svelte-kit sync && vp config --no-agent --hooks",
    "preview": "varlock-wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "test": "vp test --run",
    "test:http": "APP_ENV=test CF_SEND_TELEMETRY=false sh scripts/test-built-worker.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@tabler/icons": "^3.51.0",
    "jose": "6.2.17",
    "valibot": "1.5.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@modelcontextprotocol/client": "2.4.0",
    "@sveltejs/adapter-cloudflare": "8.0.2",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "8.72.2",
    "@varlock/cloudflare-integration": "1.6.3",
    "@varlock/vite-integration": "1.5.5",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.23.0",
    "mdsvex": "0.12.8",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "ultracite": "7.12.0",
    "varlock": "1.24.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.160.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.18.0"
  }
}
