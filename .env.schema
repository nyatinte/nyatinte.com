# @defaultRequired=infer
# @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ---
# Selects the deployment environment for Varlock.
# @type=enum(development, test, production)
APP_ENV=development

# Cloudflare Access issuer and application audience used to verify requests to /mcp.
# @optional @public @type=url
ACCESS_TEAM_DOMAIN=

# Access Application Audience (AUD) tag. This value is not a secret.
# @optional @public
ACCESS_AUDIENCE=
