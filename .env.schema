# @defaultRequired=infer
# @defaultSensitive=false
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts)
# ---
# Selects the deployment environment for Varlock.
# @type=enum(development, test, production)
APP_ENV=development

# Cloudflare Access issuer and application audience used to verify requests to /mcp.
# @required=eq($APP_ENV, production) @public @type=url
ACCESS_TEAM_DOMAIN=

# Access Application Audience (AUD) tag. This value is not a secret.
# @required=eq($APP_ENV, production) @public
ACCESS_AUDIENCE=

# GitHub token for creating achievement pull requests.
# @required=eq($APP_ENV, production) @sensitive
ACHIEVEMENT_GITHUB_TOKEN=
