{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nyatinte-com",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "account_id": "b18ddc251d51425f2abc6f750618896e",
  "keep_vars": true,
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "nyatinte.com", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
